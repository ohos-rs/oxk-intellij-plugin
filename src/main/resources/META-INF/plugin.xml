<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.ohosrs.oxkintellijplugin</id>
    <name>Oxk</name>
    <vendor email="southsouth0929@foxmail.com" url="https://github.com/ohos-rs/oxc-ark">ohos-rs</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.json</depends>
    <depends>com.huawei.ohos</depends>

    <resource-bundle>messages.OxfmtBundle</resource-bundle>
    <resource-bundle>messages.OxlintBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Oxk" displayType="BALLOON"/>
        <iconProvider implementation="com.github.ohosrs.oxkintellijplugin.OxkIconProvider"/>

        <postStartupActivity implementation="com.github.ohosrs.oxkintellijplugin.lsp.OxkLspStartupActivity"/>
        <annotator
                language="JavaScript"
                implementationClass="com.github.ohosrs.oxkintellijplugin.lsp.OxkCachedLspDiagnosticAnnotator"/>
        <annotator
                language="TypeScript"
                implementationClass="com.github.ohosrs.oxkintellijplugin.lsp.OxkCachedLspDiagnosticAnnotator"/>
        <annotator
                language="ExtendTypeScript"
                implementationClass="com.github.ohosrs.oxkintellijplugin.lsp.OxkCachedLspDiagnosticAnnotator"/>

        <projectConfigurable
                parentId="tools"
                instance="com.github.ohosrs.oxkintellijplugin.oxlint.settings.OxlintConfigurable"
                id="OxlintConfigurable"
                nonDefaultProject="false"
                bundle="messages.OxlintBundle"
                key="oxlint.name"
        />
        <projectConfigurable
                parentId="tools"
                instance="com.github.ohosrs.oxkintellijplugin.oxfmt.settings.OxfmtConfigurable"
                id="OxfmtConfigurable"
                nonDefaultProject="false"
                bundle="messages.OxfmtBundle"
                key="oxfmt.name"
        />

        <actionOnSaveInfoProvider
                id="OxkOnSaveInfoProvider"
                implementation="com.github.ohosrs.oxkintellijplugin.settings.OxkOnSaveInfoProvider"
                order="after FormatOnSaveInfoProvider, after EsLintOnSaveInfoProvider, before FileWatcherOnSaveInfoProvider, before UploadOnSaveInfoProvider"
        />

        <actionOnSave
                id="OxlintFixAllOnSaveAction"
                implementation="com.github.ohosrs.oxkintellijplugin.oxlint.actions.OxlintFixAllOnSaveAction"
                order="first, before FormatOnSaveAction"
        />
        <actionOnSave
                id="OxfmtFixAllOnSaveAction"
                implementation="com.github.ohosrs.oxkintellijplugin.oxfmt.actions.OxfmtFixAllOnSaveAction"
                order="first, before FormatOnSaveAction"
        />
    </extensions>

    <extensions defaultExtensionNs="JavaScript">
        <JsonSchema.ProviderFactory implementation="com.github.ohosrs.oxkintellijplugin.oxlint.OxlintSchemaProviderFactory"/>
        <JsonSchema.ProviderFactory implementation="com.github.ohosrs.oxkintellijplugin.oxfmt.OxfmtSchemaProviderFactory"/>
    </extensions>

    <actions>
        <action
                id="OxlintApplyFixAllAction"
                text="Apply Oxk Lint Quick Fixes"
                description="Apply Oxk lint quick fixes"
                class="com.github.ohosrs.oxkintellijplugin.oxlint.actions.OxlintFixAllAction"
        >
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action
                id="OxfmtApplyFixAllAction"
                text="Apply Oxk Format"
                description="Format with Oxk"
                class="com.github.ohosrs.oxkintellijplugin.oxfmt.actions.OxfmtFixAllAction"
        >
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>

    <applicationListeners>
        <listener
                class="com.github.ohosrs.oxkintellijplugin.oxlint.listeners.OxlintConfigWatcher"
                topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"
        />
        <listener
                class="com.github.ohosrs.oxkintellijplugin.oxfmt.listeners.OxfmtConfigWatcher"
                topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"
        />
    </applicationListeners>
</idea-plugin>
